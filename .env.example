# ============================================================
#  .env 示例文件
#  复制成 .env 后填入真实值：  cp .env.example .env
#  ⚠️ .env 已被 .gitignore 排除，不会被提交
# ============================================================

# ---- QQ 机器人（q.qq.com → 开发设置）----
QQ_BOT_APPID=
QQ_BOT_SECRET=

# ---- AI 服务商（OpenAI 兼容格式，换服务商只改这三行 + 模型名）----
# DeepSeek:  https://api.deepseek.com          模型 deepseek-flash
# 智谱:      https://open.bigmodel.cn/api/paas/v4  模型 glm-4-flash
AI_BASE_URL=https://api.deepseek.com
AI_API_KEY=
AI_REPLY_MODEL=deepseek-flash
AI_JUDGE_MODEL=deepseek-flash

# ---- 主人标识（⚠️ 是 openid，不是 QQ 号！见文档第 4 节）----
# 挖取方法：读 data/events-*.jsonl 里的 author.member_openid（详见 docs/项目文档.md）
BOT_OWNER_OPENID=
BOT_OWNER_NAME=

# ---- 花费上限（双保险）----
BUDGET_DAILY_YUAN=3
BUDGET_TOTAL_YUAN=10

# ---- 日志网页密码（必填，留空则服务拒绝启动）----
LOG_PASSWORD=

# ---- 可选 ----
# 模型降级链。⚠️ 必须和 AI_BASE_URL 同一个服务商，否则会 400 报错
# AI_FALLBACK_MODELS=deepseek-v4-pro
# 重试次数（瞬时 429/过载时用）
# AI_MAX_ATTEMPTS=3
# 两次模型调用之间的最小间隔，防账号级限速
# AI_MIN_GAP_MS=1500
# 单次请求超时
# AI_TIMEOUT_MS=45000
# 详细日志
XLJ_VERBOSE=1
